# Monthly sales data
sales <- c(100, 120, 130, 150, 170, 180, 200, 210, 230, 250, 270, 290)

# Create time series object
sales_ts <- ts(sales,
               start = c(2025, 1),
               frequency = 12)

# Display time series
print(sales_ts)

# Plot time series
plot(sales_ts,
     main = "Monthly Sales Time Series",
     xlab = "Year",
     ylab = "Sales",
     type = "o")

# Add linear regression
time <- 1:length(sales)
model <- lm(sales ~ time)

# Display regression model
print(summary(model))
