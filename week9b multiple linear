                           # Multiple Linear Regression

# Independent Variables
Experience <- c(1,2,3,4,5,6)
Education <- c(12,12,15,15,16,18)

# Dependent Variable
Salary <- c(25000,28000,35000,42000,50000,60000)

# Create Data Frame
employee <- data.frame(Experience, Education, Salary)

# Display Dataset
print(employee)

# Build Multiple Regression Model
model <- lm(Salary ~ Experience + Education, data = employee)

# Display Summary
summary(model)

# Display Coefficients
coef(model)

# Display Predicted Salary
predict(model)

plot(employee$Experience,
     employee$Salary,
     main = "Experience vs Salary",
     xlab = "Experience (Years)",
     ylab = "Salary",
     pch = 19,
     col = "blue",abline(lm(Salary~Experience)))
