# Sample Data
Hours <- c(1, 2, 3, 4, 5, 6)
Marks <- c(35, 40, 50, 55, 65, 75)

# Display Data
print(Hours)
print(Marks)

# Correlation
correlation <- cor(Hours, Marks)
cat("Correlation =", correlation, "\n")

# Covariance
covariance <- cov(Hours, Marks)
cat("Covariance =", covariance, "\n")

# Linear Regression Model
model <- lm(Marks ~ Hours)

# Display Regression Equation
print(summary(model))

# Scatter Plot
plot(Hours, Marks,
     main = "Regression Analysis",
     xlab = "Study Hours",
     ylab = "Marks",
     pch = 19,
     col = "blue")

# Regression Line
abline(model, col = "red", lwd = 2)
