# 1. DNORM - Normal Density Function

# Generate X values
x <- seq(20, 80, by = 1)

# Density values
y <- dnorm(x, mean = 50, sd = 10)

# Create chart file
png(file = "dnorm.png")

# Plot
plot(x, y,
     type = "p",
     pch = 19,
     col = "blue",
     main = "Normal Density (dnorm)",
     xlab = "Marks",
     ylab = "Density")

# Regression line
model <- lm(y ~ x)
abline(model, col = "red", lwd = 2)

# Model summary
summary(model)

dev.off()


